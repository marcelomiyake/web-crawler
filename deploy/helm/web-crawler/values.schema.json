{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["images", "services", "postgres", "crawler"],
  "properties": {
    "images": {
      "type": "object",
      "required": ["api", "worker", "frontend"],
      "properties": {
        "api": { "$ref": "#/definitions/image" },
        "worker": { "$ref": "#/definitions/image" },
        "frontend": { "$ref": "#/definitions/image" }
      }
    },
    "services": {
      "type": "object",
      "required": ["api", "worker", "frontend"],
      "properties": {
        "api": { "$ref": "#/definitions/replicatedService" },
        "worker": { "allOf": [{ "$ref": "#/definitions/replicatedService" }, { "type": "object", "required": ["concurrency"], "properties": { "concurrency": { "type": "integer", "minimum": 1, "maximum": 8 } } }] },
        "frontend": { "$ref": "#/definitions/replicatedService" }
      }
    },
    "postgres": {
      "type": "object",
      "required": ["image", "database", "username", "existingSecret", "secretPasswordKey", "storageClassName", "storageSize"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "database": { "type": "string", "minLength": 1 },
        "username": { "type": "string", "minLength": 1 },
        "existingSecret": { "type": "string", "minLength": 1 },
        "secretPasswordKey": { "type": "string", "minLength": 1 },
        "storageClassName": { "type": "string", "minLength": 1 },
        "storageSize": { "type": "string", "pattern": "^[1-9][0-9]*Gi$" }
      }
    },
    "crawler": {
      "type": "object",
      "required": ["userAgent", "productToken"],
      "properties": {
        "userAgent": { "type": "string", "minLength": 1, "maxLength": 200 },
        "productToken": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "replicatedService": {
      "type": "object",
      "required": ["replicas", "resources"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 2 },
        "resources": { "type": "object" }
      }
    }
  }
}
